# Copy to .env (gitignored) and fill in.
# Mapillary API v4 access token (https://www.mapillary.com/dashboard/developers)
MAPILLARY_ACCESS_TOKEN=
# Google Maps Platform key with Street View Static API enabled (pilot-only fallback)
GOOGLE_MAPS_API_KEY=
# Optional: read-only R2 credentials to read spatia-data layers (fema_flood_zones, overture_buildings)
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=spatia-data
